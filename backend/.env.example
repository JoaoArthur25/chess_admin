# Secret used to sign session tokens (HMAC-SHA256), min 16 chars.
# REQUIRED in production — the server refuses to start without it.
# In development a random per-process secret is used (sessions reset on restart).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Repository: "memory" (default, no DB) or "prisma"
REPO=memory

# Pairing engine: "fake" (default, deterministic) or "bbp" (real bbpPairings)
PAIRING_ENGINE=fake
# Path to the bbpPairings binary when PAIRING_ENGINE=bbp
PAIRING_ENGINE_PATH=bbpPairings

# JaVaFo — the other FIDE-endorsed engine, used for cross-validation.
# Optional: without it the cross-validation tests skip themselves.
# Needs a JRE. Download: http://www.rrweb.org/javafo/current/javafo.jar
JAVAFO_PATH=C:/Trabalhos-Dev/javafo/javafo.jar

# Required only when REPO=prisma.
# Matches docker-compose.yml, which publishes Postgres on host port 5433 (not
# the default 5432) so it never collides with another local Postgres.
DATABASE_URL=postgresql://chess:chess@localhost:5433/chess_admin?schema=public

PORT=4000

# ── Security ────────────────────────────────────────────────────────────
# Exact frontend origin(s), comma separated. REQUIRED in production — a
# permissive default is refused at boot.
CORS_ORIGIN=http://localhost:5183

# Set to "false" once the club's accounts exist, to close open sign-up.
ALLOW_REGISTRATION=true

# Set to "true" when running behind a reverse proxy, otherwise the rate
# limiter sees the proxy's IP for every client and throttles everyone as one.
TRUST_PROXY=false

# Session lifetimes.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=14

# Public URL of the frontend — used to build password-reset links.
APP_URL=http://localhost:5183

# E-mail. Without SMTP_HOST, reset links are PRINTED TO THE SERVER LOG instead
# of being sent. That is fine for a single-arbiter club install, but it means
# anyone who can read the logs can reset any account — configure SMTP before
# other people have accounts.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.org
